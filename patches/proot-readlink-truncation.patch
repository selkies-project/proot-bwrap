readlink: don't detranslate a target the kernel cut short

When the tracee's buffer is shorter than the host path of a link's
target, the kernel cuts the host path to fit, and detranslating the
cut path gives a shorter, wrong guest path that no longer fills the
buffer, so callers that grow their buffer only when readlink(2) fills
it (libglnx, which pressure-vessel is built on, starts at 100 bytes)
take it as complete. Read the whole target again before detranslating.

Offered upstream as proot-me/proot#447; drop this file once it lands.
diff --git a/src/syscall/exit.c b/src/syscall/exit.c
index 3858c68..ecb0092 100644
--- a/src/syscall/exit.c
+++ b/src/syscall/exit.c
@@ -25,6 +25,7 @@
 #include <sys/utsname.h>	/* struct utsname, */
 #include <linux/net.h>		/* SYS_*, */
 #include <string.h>		/* strlen(3), */
+#include <unistd.h>		/* readlink(2), */
 
 #include "syscall/syscall.h"
 #include "syscall/sysnum.h"
@@ -375,6 +376,20 @@ void translate_syscall_exit(Tracee *tracee)
 		break;
 	    }
 
+	    /* A buffer the kernel filled may hold a target cut short.
+	     * The host path is longer than the guest path it stands
+	     * for, so detranslating the cut one would report a shorter,
+	     * wrong guest path, and callers that grow their buffer only
+	     * when readlink(2) fills it (libglnx, bubblewrap...) would
+	     * take it as complete.  Read the whole target instead.  */
+	    if (old_size == max_size) {
+		ssize_t size =
+		    readlink(referer, referee, sizeof(referee) - 1);
+
+		if (size > 0)
+		    referee[size] = '\0';
+	    }
+
 	    status = detranslate_path(tracee, referee, referer);
 	    if (status < 0)
 		break;
