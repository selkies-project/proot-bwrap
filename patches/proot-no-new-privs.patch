diff --git a/src/syscall/enter.c b/src/syscall/enter.c
index e571caa..dc8f3e8 100644
--- a/src/syscall/enter.c
+++ b/src/syscall/enter.c
@@ -677,22 +677,48 @@ int translate_syscall_enter(Tracee *tracee)
 	    translate_path2(tracee, newdirfd, newpath, SYSARG_3, SYMLINK);
 	break;
 
-    case PR_prctl:
-	/* Prevent tracees from setting dumpable flag.
-	 * (Otherwise it could break tracee memory access)  */
-	if (peek_reg(tracee, CURRENT, SYSARG_1) == PR_SET_DUMPABLE) {
-	    set_sysnum(tracee, PR_void);
-	    status = 0;
-	}
+    case PR_prctl:{
+	    word_t option = peek_reg(tracee, CURRENT, SYSARG_1);
+	    word_t arg2 = peek_reg(tracee, CURRENT, SYSARG_2);
+	    bool no_more_args;
+
+	    no_more_args = (peek_reg(tracee, CURRENT, SYSARG_3) == 0
+			    && peek_reg(tracee, CURRENT, SYSARG_4) == 0
+			    && peek_reg(tracee, CURRENT, SYSARG_5) == 0);
+
+	    /* Prevent tracees from setting dumpable flag.
+	     * (Otherwise it could break tracee memory access)  */
+	    if (option == PR_SET_DUMPABLE) {
+		set_sysnum(tracee, PR_void);
+		status = 0;
+	    }
 
-	/* The vector PR_GET_AUXV copies out is fixed up at the exit
-	 * stage, which has to be hit under seccomp as well.  */
-	if (peek_reg(tracee, CURRENT, SYSARG_1) == PR_GET_AUXV
-	    && tracee->execfn_addr != 0) {
-	    tracee->restart_how = PTRACE_SYSCALL;
-	    tracee->sysexit_pending = true;
+	    /* PRoot sets no_new_privs itself, before the program starts,
+	     * to install its seccomp filter, so the kernel would answer
+	     * PR_GET_NO_NEW_PRIVS for PRoot: answer it at the exit stage
+	     * from the program's own flag instead.  Other arguments get
+	     * the kernel's EINVAL.  */
+	    if (option == PR_GET_NO_NEW_PRIVS && arg2 == 0 && no_more_args) {
+		set_sysnum(tracee, PR_void);
+		tracee->restart_how = PTRACE_SYSCALL;
+		tracee->sysexit_pending = true;
+		status = 0;
+	    }
+
+	    /* The kernel accepts only these arguments, and the flag
+	     * cannot be cleared once set.  */
+	    if (option == PR_SET_NO_NEW_PRIVS && arg2 == 1 && no_more_args
+		&& tracee->seen_execve)
+		tracee->no_new_privs = true;
+
+	    /* The vector PR_GET_AUXV copies out is fixed up at the exit
+	     * stage, which has to be hit under seccomp as well.  */
+	    if (option == PR_GET_AUXV && tracee->execfn_addr != 0) {
+		tracee->restart_how = PTRACE_SYSCALL;
+		tracee->sysexit_pending = true;
+	    }
+	    break;
 	}
-	break;
     }
 
   end:
diff --git a/src/syscall/exit.c b/src/syscall/exit.c
index ecb0092..8d78ed1 100644
--- a/src/syscall/exit.c
+++ b/src/syscall/exit.c
@@ -465,6 +465,13 @@ void translate_syscall_exit(Tracee *tracee)
 	    word_t address;
 	    size_t size;
 
+	    /* See translate_syscall_enter().  */
+	    if (peek_reg(tracee, ORIGINAL, SYSARG_1) == PR_GET_NO_NEW_PRIVS
+		&& get_sysnum(tracee, MODIFIED) == PR_void) {
+		status = tracee->no_new_privs ? 1 : 0;
+		break;
+	    }
+
 	    /* PR_GET_AUXV copies out the vector the kernel saved
 	     * for the loader: make its AT_EXECFN name the program,
 	     * as the loader did on the stack.  */
